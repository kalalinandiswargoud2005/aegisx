<service>
  <id>ASTRA-Windows-Agent</id>
  <name>ASTRA Windows EDR Agent</name>
  <description>ASTRA Autonomous Threat Intelligence and Endpoint Security Response Agent.</description>
  
  <executable>java</executable>
  <arguments>-Djava.awt.headless=true -Xmx512m -jar "%BASE%\windows-agent.jar"</arguments>
  
  <log mode="roll">
    <logpath>%BASE%\logs</logpath>
  </log>
  
  <startmode>Automatic</startmode>
  <delayedAutoStart>false</delayedAutoStart>
  <stoptimeout>15sec</stoptimeout>
  
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="20 sec"/>
  <resetfailure>1 hour</resetfailure>
  
  <serviceaccount>
    <username>NT AUTHORITY\SYSTEM</username>
  </serviceaccount>
</service>
