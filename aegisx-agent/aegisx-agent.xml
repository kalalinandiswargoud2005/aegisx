<service>
  <id>aegisx-agent</id>
  <name>AEGISX Endpoint Agent</name>
  <description>Enterprise Windows Endpoint Monitoring Agent for AEGISX Security Platform.</description>
  <executable>java</executable>
  <arguments>-Xmx256m -jar "%BASE%\aegisx-agent-1.0.0.jar"</arguments>
  <logmode>rotate</logmode>
  <logpath>%BASE%\logs</logpath>
  <startmode>Automatic</startmode>
  <env name="AEGISX_HOME" value="%BASE%"/>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="20 sec"/>
</service>
