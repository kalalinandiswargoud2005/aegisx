<service>
  <id>astra-agent</id>
  <name>ASTRA Endpoint Agent</name>
  <description>Enterprise Windows Endpoint Monitoring Agent for ASTRA Security Platform.</description>
  <executable>java</executable>
  <arguments>-Xmx256m -jar "%BASE%\astra-agent-1.0.0.jar"</arguments>
  <logmode>rotate</logmode>
  <logpath>%BASE%\logs</logpath>
  <startmode>Automatic</startmode>
  <env name="ASTRA_HOME" value="%BASE%"/>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="20 sec"/>
</service>
